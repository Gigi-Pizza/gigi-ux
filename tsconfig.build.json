{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src/index.ts", "src/components/**/*.tsx", "src/pages/**/*.tsx", "src/types.ts", "src/vite-env.d.ts"],
  "exclude": ["src/**/*.stories.tsx"]
}
